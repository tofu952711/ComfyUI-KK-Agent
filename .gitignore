# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Runtime state — never published
logs/
*.log
user/
*.jsonl
media/

# Local machine configuration written by scripts/install.py
config.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

