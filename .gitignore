prompt-inject.md

# Reproducible portable binaries; included by package_standalone.py in release ZIP.
vendor/windows-x64/
vendor/ffmpeg/windows-x64/*.exe

# Public speaker weights are installed by scripts/setup_speaker_models.py.
models/speaker-diarization/

# Large portable assets are distributed through GitHub Releases.
models/**/*.onnx
*.zip
*.zip.sha256
